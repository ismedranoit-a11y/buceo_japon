---
/** Instagram and Facebook icon links. */
import { site } from '../../data/content.js';

interface Props { class?: string }
const { class: className } = Astro.props;

const links = [
  { href: site.instagram, label: 'Instagram de Buceo Japón', icon: 'instagram' },
  { href: site.facebook, label: 'Grupo de Facebook de Buceo Japón', icon: 'facebook' },
];
---
<ul class:list={['m-0 flex list-none items-center gap-1 p-0', className]}>
  {links.map((l) => (
    <li>
      <a
        class="inline-flex size-11 items-center justify-center no-underline transition-colors hover:text-shu"
        href={l.href}
        target="_blank"
        rel="noopener"
        aria-label={l.label}
      >
        {l.icon === 'instagram' ? (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
          </svg>
        ) : (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        )}
      </a>
    </li>
  ))}
</ul>
