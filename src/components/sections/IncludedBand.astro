---
import { ratesIncluded } from '../../data/content.js';
import CheckIcon from '../ui/CheckIcon.astro';
---
<section class="bg-navy text-cream" aria-label="Qué incluye">
  <div class="wrap flex min-h-[120px] flex-col items-start justify-between gap-x-8 gap-y-4 py-7 md:flex-row md:flex-wrap md:items-center xl:gap-x-3">
    <span class="font-display text-2xl font-bold text-coral">Incluido</span>
    <ul class="contents">
      {ratesIncluded.map((t) => <li class="flex items-center gap-3 text-[17px] font-semibold"><span class="shrink-0 text-coral"><CheckIcon /></span>{t}</li>)}
    </ul>
    <span class="text-[15px] text-mute">Equipo aparte</span>
  </div>
</section>
