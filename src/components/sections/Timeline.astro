---
import { timeline } from '../../data/content.js';
---
<ol class="grid grid-cols-1 gap-7 md:grid-cols-3 md:gap-8 xl:grid-cols-5">
  {timeline.map((t) => (
    <li class="flex flex-col gap-3.5 border-t-[3px] border-coral pt-7">
      <span class="font-display text-[40px] leading-none font-bold text-coral">{t.year}</span>
      <span class="font-display text-[22px] font-semibold text-cream">{t.title}</span>
      <span class="text-[15px] leading-relaxed text-mute">{t.text}</span>
    </li>
  ))}
</ol>
