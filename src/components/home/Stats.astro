---
import { stats } from '../../data/content.js';
---
<section class="bg-navy text-washi" aria-label="En cifras">
  <div class="wrap grid min-h-[120px] grid-cols-2 items-center gap-x-4 gap-y-5 py-6 lg:grid-cols-3">
    {stats.map((s) => (
      <div class="flex flex-wrap items-baseline gap-x-3.5 gap-y-1 border-l border-washi/30 pl-3.5 md:pl-6">
        <span class="font-mincho text-[28px] font-bold text-coral md:text-[34px]" lang="ja">{s.jpValue}</span>
        <span class="text-[15px]">{s.jpLabel}</span>
      </div>
    ))}
  </div>
</section>
