---
import { site } from '../../data/content.js';
import { url } from '../../lib/url';
import Logo from '../ui/Logo.astro';
import Hanko from './Hanko.astro';
import JapaneseButton from './JapaneseButton.astro';

const photo = url('images/puntos-buceo/atami.webp');
const waves = url('images/fondo.jpg');
---
<section class="relative overflow-hidden">
  <div class="wrap relative flex flex-wrap items-center gap-x-8 gap-y-6 pt-12 pb-16 lg:grid lg:min-h-[860px] lg:grid-cols-[auto_minmax(0,1fr)_38%] lg:gap-10 lg:py-0 xl:gap-14 min-[1440px]:grid-cols-[auto_minmax(0,1fr)_44%]">
    <div class="order-1 flex gap-2 self-stretch font-mincho font-bold tracking-[0.15em] md:gap-5 md:tracking-[0.25em] lg:order-none lg:pt-24" lang="ja" aria-hidden="true">
      <span class="vertical-rl text-[24px] text-navy md:text-[40px] lg:text-[52px] xl:text-[64px]">日本の海を潜る</span>
      <span class="vertical-rl pt-8 text-[13px] text-ink md:pt-[72px] md:text-lg lg:pt-[120px] lg:text-[22px]">伊豆・熱海</span>
    </div>
    <div class="order-3 flex w-full min-w-0 basis-full flex-col gap-6 md:gap-8 lg:order-none lg:w-auto lg:basis-auto">
      <div class="flex items-center gap-4"><Hanko kanji="潜" /><span class="text-sm font-bold uppercase tracking-[1.6px]">Guía e instructor SSI en español</span></div>
      <h1 class="font-mincho text-[clamp(48px,6.4vw,92px)] lg:text-[clamp(48px,5.6vw,80px)] leading-[1.08] font-extrabold">Explora el azul de Japón</h1>
      <p class="text-[19px] leading-[1.8] text-ink lg:max-w-[480px]">Inmersiones guiadas y cursos por toda la península de Izu. Buceo tranquilo, sin prisas, y todo explicado en tu idioma.</p>
      <div class="flex flex-wrap gap-3.5">
        <JapaneseButton href={site.bookingUrl} class="max-sm:flex-1 max-sm:basis-full">Reservar inmersión</JapaneseButton>
        <JapaneseButton href={url('puntos-buceo/')} variant="line" class="max-sm:flex-1 max-sm:basis-full">Puntos de buceo</JapaneseButton>
      </div>
    </div>
    <!-- Underwater photo. Mobile: a box next to the vertical kanji. Desktop: the right column, bleeding to the
         viewport edge, so it never slides under the text. The octopus sits on it as a round seal. -->
    <div
      class="relative order-2 min-h-[210px] min-w-[180px] flex-1 self-stretch bg-navy bg-cover bg-center md:min-h-[340px] lg:order-none lg:-mr-[calc((100vw-min(100vw,1440px))/2+clamp(16px,6.6vw,96px))]"
      style={`background-image: url('${photo}')`}
    >
      <span
        class="absolute -bottom-5 -left-3 flex size-[96px] items-center justify-center overflow-hidden rounded-full border-[5px] border-washi bg-navy bg-cover bg-center md:size-[160px] lg:bottom-12 lg:-left-6 lg:size-auto lg:aspect-square lg:w-[min(240px,70%)] lg:border-8"
        style={`background-image: url('${waves}')`}
      >
        <Logo width={240} alt="Pulpo de Buceo Japón" eager class="h-auto w-[96%] object-contain" />
      </span>
    </div>
  </div>
</section>
